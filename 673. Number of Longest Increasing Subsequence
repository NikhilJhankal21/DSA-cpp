class Solution {
public:
    int findNumberOfLIS(vector<int>& nums) {
        int n=nums.size();
        vector<int>LIS(n,1);
        vector<int>count(n,1);
        for(int i=0;i<n;i++){
            for(int j=0;j<i;j++){
                if(nums[j]<nums[i]){
                    if(LIS[j]+1==LIS[i]){
                        count[i]+=count[j];
                    }else if(LIS[j]+1>LIS[i]){
                        LIS[i]=LIS[j]+1;
                        count[i]=count[j];
                    }
                }
            }
        }
        int maxlength=*max_element(LIS.begin(),LIS.end());
        int result=0;
        for(int i=0;i<n;i++){
            if(LIS[i]==maxlength){
                result+=count[i];
            }
        }
        return result;
    }
};
