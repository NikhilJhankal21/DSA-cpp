class Solution {
public:
    int minCost(vector<int>& startPos, vector<int>& homePos, vector<int>& rowCosts, vector<int>& colCosts) {
        int r1=startPos[0];
        int c1=startPos[1];
        int r2=homePos[0];
        int c2=homePos[1];
        int ans=0;
        if(r2>=r1){
            for(int r=r1+1 ; r<=r2; r++){
                ans+=rowCosts[r];
            }
        }else{
            for(int r=r1-1; r>=r2; r--){
                ans+=rowCosts[r];
            }
        }

        if(c2>=c1){
            for(int c=c1+1; c<=c2; c++){
                ans+=colCosts[c];
            }
        }else{
            for(int c=c1-1;c>=c2; c--){
                ans+=colCosts[c];
            }
        }
        return ans;
    }
};
