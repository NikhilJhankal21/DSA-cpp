class Solution {
public:
    int countRotations(string s, int k) {
        int ans = 0;
        int n = s.length();
        for (int i = 0; i < n; i++) {
            rotate(s.begin(), s.begin() + 1, s.end());
            int score = 0;
            for (int i = 0; i < s.length() - 1; i++) {
                if (s[i] == s[i + 1]) {
                    score++;
                }
            }
                if (score== k) {
                    ans++;
                }
        }
        return ans;
    }
};
