class Solution {
public:
    int countValidPrefixes(string s) {
        int count=0;
        int one=0;
        int zero=0;
        for(int i=0;i<s.length();i++){
            if(s[i]=='0') zero++;
            if(s[i]=='1') one++;
            if(abs(one-zero)<=1){
                count++;
            }
        }
        return count;
    }
};
