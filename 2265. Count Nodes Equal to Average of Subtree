class Solution {
public:
    pair<int,int>solve(TreeNode*root, int &result){
        if(root==NULL) return {0,0};
        pair<int,int>p1=solve(root->left,result);
        pair<int,int>p2=solve(root->right,result);

        int totalSum=p1.first+p2.first+root->val;
        int totalCount=p1.second + p2.second +1;

        int avg= totalSum/totalCount;
        if(avg==root->val){
            result++;
        }

        return {totalSum,totalCount};
    }
    int averageOfSubtree(TreeNode* root) {
        int result=0;
        solve(root,result);
        return result;
    }
};
