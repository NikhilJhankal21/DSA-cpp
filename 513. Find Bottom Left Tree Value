class Solution {
public:
    int findBottomLeftValue(TreeNode* root) {
        queue<TreeNode*>q;
        q.push(root);
        
        int ans=root->val;
        while(q.size()>0){
            int n=q.size();
            ans=q.front()->val;
            for(int i=0;i<n;i++){
                TreeNode*curr=q.front();
                q.pop();
                if(curr->left!=NULL){
                    q.push(curr->left);
                }
                if(curr->right!=NULL){
                    q.push(curr->right);
                }
            }
        }
        return ans;
    }
};
