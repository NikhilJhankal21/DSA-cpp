class Solution {
public:
    int findTotal(int n,int target,vector<int>&dp,vector<int>&nums){
        if(target==0){
            return 1;
        }
        if( target<0){
            return 0;
        }
        if(dp[target]!=-1) return dp[target];
        int result=0;
        for(int j=0;j<n;j++){
            result+=findTotal(n,target-nums[j],dp,nums);
        }
        return dp[target]=result;
    }
    int combinationSum4(vector<int>& nums, int target) {
        int n=nums.size();
        vector<int>dp(target+1,-1);
        return findTotal(n,target,dp,nums);
    }
};
