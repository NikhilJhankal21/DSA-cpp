class Solution { // Top-Down
public:
    bool match(int m,int n,string &s, string &p, vector<vector<int>>&dp){
        if(n==0 && m==0) return 1;
        if(n==0 && m) return 0;
        // if m==0 and n exist krta hai and second string mai saare ke saare elements agar * hai toh answer 1 nhi toh 0
        if(m==0){
            for(int k=0;k<n;k++){
                if(p[k]!='*'){
                    return 0;
                }
            }
            return 1;
        }
        if(dp[m][n]!=-1) return dp[m][n];
        if(p[n-1]=='?'){
            return dp[m][n]=match(m-1,n-1,s,p,dp);
        }else if(p[n-1]=='*'){
            return dp[m][n]=match(m,n-1,s,p,dp) || match(m-1,n,s,p,dp);
        }else if(s[m-1]==p[n-1]){
            return dp[m][n]=match(m-1,n-1,s,p,dp);
        }else{
            return 0;
        }
    }
    bool isMatch(string s, string p) {
        int m=s.size();
        int n=p.size();
        vector<vector<int>>dp(m+1,vector<int>(n+1,-1));
        return match(m,n,s,p,dp);
    }
};
