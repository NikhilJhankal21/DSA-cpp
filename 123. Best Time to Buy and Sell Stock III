// Top-Down 

class Solution {
public:
    int maximumProfit(int index,int buy, int transaction,int n,vector<vector<vector<int>>>&dp, vector<int>& prices){
        // No transactions left or array khatam
        if(transaction==0 || index==n) return 0;
        if(dp[index][buy][transaction]!=-1) return dp[index][buy][transaction];
        if(buy){
            // Either I can buy the stock today or I will not buy the stock today
            return dp[index][buy][transaction]= max(-prices[index]+maximumProfit(index+1,0,transaction,n,dp,prices),maximumProfit(index+1,1,transaction,n,dp,prices));
        }else{
            // Either I can sell the stock today or I will not sell the stock today
            return dp[index][buy][transaction]= max(prices[index]+maximumProfit(index+1,1,transaction-1,n,dp,prices),maximumProfit(index+1,0,transaction,n,dp,prices));
        }
    }
    int maxProfit(vector<int>& prices) {
        int n=prices.size();
        vector<vector<vector<int>>>dp(n+1,vector<vector<int>>(2,vector<int>(3,-1)));
        return maximumProfit(0,1,2,n,dp,prices);
    }
};
